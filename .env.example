# Django Expense Manager - Environment Configuration Example

# Secret Key
DJANGO_SECRET_KEY=django-insecure-jlu7wkr)p=pz)z)_!aph&f@op--%g7c3hat*q4#s%6=7cx)b#s
DJANGO_DEBUG=True

# Allowed Hosts & CSRF
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration:
# USE_LOCAL_DB=True  --> Uses offline SQLite (db.sqlite3) [Recommended for offline exam / local testing]
# USE_LOCAL_DB=False --> Uses Cloud PostgreSQL (Neon DB / Supabase via DATABASE_URL)
USE_LOCAL_DB=True

# Cloud Database URL (Used only when USE_LOCAL_DB=False or on Vercel)
DATABASE_URL=postgresql://neondb_owner:password@ep-something.aws.neon.tech/neondb?sslmode=require

# Email Settings (Optional for offline)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
